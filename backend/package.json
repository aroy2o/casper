{
  "name": "casper-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "backup": "tsx src/scripts/backup-db.ts",
    "seed:detailed": "NODE_ENV=development tsx src/scripts/seed.ts",
    "safe-reseed": "tsx src/scripts/backup-db.ts && NODE_ENV=development tsx src/scripts/seed.ts",
    "backfill:cost-breakdown": "tsx src/scripts/backfill-cost-breakdown.ts",
    "seed:india": "NODE_ENV=development tsx src/scripts/seed-india-districts.ts",
    "seed:market-refs": "NODE_ENV=development tsx src/scripts/seed-market-references.ts",
    "seed:all-states": "tsx src/scripts/seed-all-states.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.8.7",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.4",
    "puppeteer": "^23.5.3",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/socket.io-client": "^3.0.0",
    "eslint": "^9.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
